    "jest-expo": "~58.0.13",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:native": "npx eas-cli@latest build -p all",
    "submit": "npx eas-cli@latest submit -p all",
    "build:web": "npm run content:snapshot && expo export -p web",
    "release": "npm run build:native && npm run submit && npm run build:web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "db:seed-sql": "tsx scripts/content-seed-sql.ts",
    "db:test": "scripts/test-db.sh",
    "db:update-content": "scripts/db-update-content.sh",
    "content:snapshot": "tsx scripts/content-snapshot.ts",
    "eas-build-post-install": "npm run content:snapshot",
    "cms:dev": "npm --prefix cms run dev",
    "cms:build": "npm --prefix cms run build",
    "ios:free-team": "scripts/ios-free-team.sh"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
