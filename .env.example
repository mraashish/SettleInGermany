# Copy to .env.local (used by the apps, the CMS in cms/ and the build scripts).
# Everything is optional: without values the app runs on the bundled seed content,
# the CMS runs in demo mode, AI uses demo responses and ads show placeholders.

# Public site URL (canonical links, sharing)
EXPO_PUBLIC_SITE_URL=https://settleingermany.app

# Our backend (ALL AI calls go through it; the client never holds model keys)
EXPO_PUBLIC_API_URL=

# Supabase — the central content database (docs/CMS.md), optional accounts and push registration.
# The anon key is public by design; row-level security protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Edge Function secrets are NOT set here — use `npx supabase secrets set` (see docs/CMS.md).

# RevenueCat public SDK keys — one "premium" entitlement across stores
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
EXPO_PUBLIC_RC_WEB_KEY=
EXPO_PUBLIC_RC_WEB_PORTAL=

# Ads (free tier only, after consent). Also replace the test app IDs in app.json.
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADSENSE_CLIENT=
EXPO_PUBLIC_ADSENSE_BANNER_SLOT=
EXPO_PUBLIC_ADSENSE_NATIVE_SLOT=
